# ---------------------------------------------------------------------------
# Django core
# ---------------------------------------------------------------------------
# Generate one with: python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
# Required when DEBUG=False; the app refuses to start without it.
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Production examples (use the real API host, not the site host):
# ALLOWED_HOSTS=api.vishnuanilkumar.in
# SITE_URL=https://vishnuanilkumar.in
# ADMIN_URL=https://admin.vishnuanilkumar.in
# NUM_PROXIES=1   # Render/Railway sit behind exactly one proxy

# SQLite by default. In production use a PostgreSQL URL, e.g.
# DATABASE_URL=postgres://user:password@host:5432/portfolio
DATABASE_URL=

# Hosting build hook (Netlify/Cloudflare Pages/Vercel). Leave empty to disable
# automatic publishing. This is a server-side secret: never expose it as a
# VITE_* variable or commit it. See docs/deployment.md.
SITE_REBUILD_HOOK_URL=

# Comma-separated. Include the public site AND the admin panel origins.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174
# Production example:
# CORS_ALLOWED_ORIGINS=https://vishnuanilkumar.in,https://www.vishnuanilkumar.in,https://admin.vishnuanilkumar.in
# CSRF_TRUSTED_ORIGINS=https://api.vishnuanilkumar.in

# Public URLs used for canonical links, chatbot source chips and emails.
SITE_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# ---------------------------------------------------------------------------
# Chatbot
# ---------------------------------------------------------------------------
# auto = Groq when an API key is present, otherwise local Ollama.
# Supported: auto, groq, openai, ollama, extractive
CHATBOT_PROVIDER=auto
CHATBOT_MAX_TOKENS=400

# Local development (Ollama)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b

# Production (Groq free tier, OpenAI-compatible)
GROQ_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# ---------------------------------------------------------------------------
# Email (contact-form notifications). Console backend when EMAIL_HOST is empty.
# ---------------------------------------------------------------------------
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_TIMEOUT=10
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Vishnu Portfolio <no-reply@vishnuanilkumar.in>
CONTACT_NOTIFICATION_EMAIL=vishnuanil2k05@gmail.com

# ---------------------------------------------------------------------------
# Production hardening
# ---------------------------------------------------------------------------
# Leave unset to inherit sane defaults: on when DEBUG=False.
SECURE_SSL_REDIRECT=
# Keep uploads on Django for a small portfolio; point MEDIA_URL at object
# storage (and set this to False) when traffic grows.
SERVE_MEDIA=True
